{
  "dxt_version": "0.2",
  "name": "vra_iaas-mcp",
  "version": "0.0.1",
  "description": "The official MCP Server for the Vra Iaas API",
  "author": {
    "name": "Vra Iaas",
    "email": "sales@vmware.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imtrinity94/vra-iaas-mcp-typescript.git"
  },
  "homepage": "https://github.com/imtrinity94/vra-iaas-mcp-typescript/tree/main/packages/mcp-server#readme",
  "documentation": "https://www.vmware.com/",
  "server": {
    "type": "node",
    "entry_point": "index.js",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/index.js"
      ],
      "env": {
        "VRA_FQDN": "${user_config.VRA_FQDN}",
        "VRA_USERNAME": "${user_config.VRA_USERNAME}",
        "VRA_PASSWORD": "${user_config.VRA_PASSWORD}"
      }
    }
  },
  "user_config": {
    "VRA_FQDN": {
      "title": "vra_fqdn",
      "description": "FQDN of your vRA appliance (for example: vra.example.local)",
      "required": true,
      "type": "string"
    },
    "VRA_USERNAME": {
      "title": "vra_username",
      "description": "Username for vRA login",
      "required": true,
      "type": "string"
    },
    "VRA_PASSWORD": {
      "title": "vra_password",
      "description": "Password for vRA login",
      "required": true,
      "type": "string"
    }
  },
  "tools": [],
  "tools_generated": true,
  "compatibility": {
    "runtimes": {
      "node": ">=18.0.0"
    }
  },
  "keywords": [
    "api"
  ]
}